{
  "name": "lynage-memory-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/ apps/ benchmarks/",
    "lint:fix": "eslint packages/ apps/ benchmarks/ --fix",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "unrun": "^0.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "promptfoo": "^0.121.20",
    "sharp": "^0.35.3"
  }
}
