{
  "name": "@lynage/core",
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --minify --no-sourcemap",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-node": "^1.27.0",
    "zod": "^3.24.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
