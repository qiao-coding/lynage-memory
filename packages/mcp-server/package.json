{
  "name": "@lynage/mcp",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "lynage-memory": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format cjs,esm --dts --minify --no-sourcemap",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lynage/core": "workspace:*",
    "@lynage/storage-sqlite": "workspace:*",
    "@lynage/ai-sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ai": "^4.3.0",
    "zod": "^3.24.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {},
  "optionalDependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/deepseek": "^0.2.0",
    "@ai-sdk/anthropic": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
