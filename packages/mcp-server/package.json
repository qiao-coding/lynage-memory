    "zod": "^3.24.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {},
  "optionalDependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/deepseek": "^0.2.0",
    "@ai-sdk/anthropic": "^1.0.0"
  }
