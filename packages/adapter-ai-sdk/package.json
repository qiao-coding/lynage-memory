{
  "name": "@lynage/ai-sdk",
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --minify --no-sourcemap",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lynage/core": "workspace:*",
    "ai": "^4.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^1.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
