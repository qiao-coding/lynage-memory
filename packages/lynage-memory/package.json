{
  "name": "lynage-memory",
  "version": "0.0.2",
  "description": "Long-term story memory for AI agents — novels, Galgame, interactive fiction. Store every word, recall plot detail on demand, fixed context cost.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "lynage-memory": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format cjs,esm --dts --minify --no-sourcemap",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lynage/ai-sdk": "workspace:*",
    "@lynage/core": "workspace:*",
    "@lynage/mcp": "workspace:*",
    "@lynage/storage-sqlite": "workspace:*",
    "tsx": "^4.23.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
