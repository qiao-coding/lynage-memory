{
  "name": "lynage-memory",
  "version": "0.0.1",
  "description": "Long-term story memory for AI agents — novels, Galgame, interactive fiction. Store every word, recall plot detail on demand, fixed context cost.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "lynage-memory": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lynage/ai-sdk": "workspace:*",
    "@lynage/core": "workspace:*",
    "@lynage/mcp": "workspace:*",
    "@lynage/storage-sqlite": "workspace:*",
    "tsx": "^4.23.1"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
